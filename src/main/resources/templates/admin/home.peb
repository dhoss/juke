            <div class="card border-0 h-100">
                <a href="{{ href('/admin/forums') }}">

                    <img src="{{ href('/img/forums.png') }}" height="48" width="48" alt="...">
                    <div class="card-body">
                        <h5 class="card-title">Forums</h5>
                    </div>
                </a>
            </div>
        </div>
        <div class="col">
            <a href="{{ href('/admin/assets') }}">
                <img src="{{ href('/img/assets.png') }}" height="48" width="48" alt="...">
                <div class="card border-0 h-100">

                    <div class="card-body">
                        <h5 class="card-title">Assets</h5>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="{{ href('/admin/motd') }}">

                <img src="{{ href('/img/motd.png') }}" height="48" width="48" alt="...">
                <div class="card border-0 h-100">

                    <div class="card-body">
                        <h5 class="card-title">MOTD</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <div class="card border-0 h-100">
                <a href="{{ href('/admin/layouts') }}">
                    <img src="{{ href('/img/layouts.png') }}" height="48" width="48" alt="...">

                    <div class="card-body">
                        <h5 class="card-title">Layouts</h5>
                    </div>
                </a>
            </div>
        </div>
        <div class="col">
            <a href="{{ href('/admin/polls') }}">
                <img src="{{ href('/img/polls.png') }}" height="48" width="48" alt="...">
                <div class="card border-0 h-100">

                    <div class="card-body">
                        <h5 class="card-title">Polls</h5>
                    </div>
                </div>
            </a>
        </div>
