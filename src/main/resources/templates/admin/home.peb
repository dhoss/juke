    {% extends "fragments/admin/layout" %}
    {% block body %}
    <h1>Admin</h1>
    <div class="row row-cols-4 g-4">
        <div class="col">
            <div class="card border-0 h-100">
                <a href="{{ href('/admin/pages') }}">
                    <img src="{{ href('/img/pages.png') }}" height="48" width="48" alt="...">


                    <div class="card-body">
                        <h5 class="card-title">Pages</h5>
                    </div>
                </a>
            </div>
        </div>
        <div class="col">
            <a href="{{ href('/admin/config') }}">
                <div class="card border-0 h-100">
                    <img src="{{ href('/img/config.png') }}" height="48" width="48" alt="...">

                    <div class="card-body">
                        <h5 class="card-title">Config</h5>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="{{ href('/admin/metrics') }}">
                <div class="card border-0 h-100">

                    <img src="{{ href('/img/metrics.png') }}" height="48" width="48" alt="...">
                    <div class="card-body">
                        <h5 class="card-title">Metrics</h5>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="{{ href('/admin/news') }}">
                <div class="card border-0 h-100">

                    <img src="{{ href('/img/news.png')}}" height="48" width="48" alt="...">
                    <div class="card-body">
                        <h5 class="card-title">News</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row row-cols-4 g-4">
