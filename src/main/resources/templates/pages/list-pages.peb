    {% extends 'fragments/layout' %}
        {% macro renderTree(pages) %}

        <ul>
                {% for page in pages %}
                <li>
                    {# TODO: create a macro for generating proper urls #}
                    <a href="/{{ page.slug }}.html">{{ page.title }}</a>
                    {% if page.children is not empty %}
                    {{ renderTree(page.children) }}
                    {% endif %}
                </li>
                {% endfor %}
        </ul>
        {% endmacro %}
    {% block body %}
    <h1>Pages</h1>
    {{ renderTree(pages) }}
    {% endblock %}